{
  "name": "@tigerdata/storybook-addon-md",
  "version": "0.11.0",
  "description": "Discover ordinary Markdown and render it in Storybook Docs.",
  "keywords": [
    "docs",
    "markdown",
    "react",
    "storybook-addons",
    "vite"
  ],
  "homepage": "https://github.com/timescale/storybook-addon-md#readme",
  "bugs": {
    "url": "https://github.com/timescale/storybook-addon-md/issues"
  },
  "license": "MIT",
  "author": "TigerData",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timescale/storybook-addon-md.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "STYLING.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/preset.js"
    },
    "./preset": "./dist/preset.js",
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js"
    },
    "./package.json": "./package.json",
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --log-level warn",
    "storybook": "./bun run build && storybook dev -p 6006 -c example/.storybook --no-open --disable-telemetry",
    "storybook:mcp": "./bun run build && storybook dev -p 6007 -c example/.storybook-mcp --no-open --disable-telemetry",
    "build-storybook": "./bun run build && storybook build -c example/.storybook --disable-telemetry",
    "build-storybook:mcp": "./bun run build && storybook build -c example/.storybook-mcp -o storybook-static-mcp --disable-telemetry",
    "check": "./bun run build && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:watch": "vitest --config vitest.browser.config.ts",
    "test:e2e": "playwright test",
    "test:package": "node --experimental-strip-types test/package-smoke.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "./bun run build",
    "release": "./bun release.ts"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "picomatch": "^4.0.7",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/browser-playwright": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.5",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
