{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "example/**/*.ts",
    "example/**/*.tsx",
    "example/.storybook/*.ts",
    "example/.storybook/*.tsx",
    "vitest*.config.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "playwright.config.ts",
    "example/.storybook-mcp/*.ts",
    "tsdown.config.ts",
    "release.ts"
  ]
}
